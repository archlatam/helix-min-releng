// Helix Linux — niri (live y sistema instalado, vía /etc/skel)
// Sin Noctalia: al entrar se abre sólo archlatam-welcome.
// Paleta Catppuccin Mocha: crust / mauve / surface1 / red.

input {
    keyboard {
        xkb {
            layout "latam"
        }
        numlock
    }
    touchpad {
        tap
        natural-scroll
        dwt
    }
    focus-follows-mouse max-scroll-amount="0%"
}

layout {
    gaps 12
    center-focused-column "never"
    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }
    default-column-width { proportion 0.5; }
    focus-ring { off; }
    border {
        width 2
        active-color "#cba6f7"
        inactive-color "#45475a"
        urgent-color "#f38ba8"
    }
    background-color "#11111b"
}

prefer-no-csd
screenshot-path "~/Pictures/Screenshots/%Y-%m-%d %H-%M-%S.png"

hotkey-overlay {
    skip-at-startup
}

// Qt bajo Wayland; Kvantum aplica Catppuccin (ver .config/Kvantum/kvantum.kvconfig).
environment {
    QT_QPA_PLATFORM "wayland;xcb"
    QT_QPA_PLATFORMTHEME "qt6ct"
    QT_STYLE_OVERRIDE "kvantum"
    XCURSOR_SIZE "24"
}

// Instalador y bienvenida: flotantes y centradas al abrir.
window-rule {
    match title="ArchLatam Welcome"
    match app-id="ArchLatam Welcome"
    match app-id="archlatam-welcome"
    open-floating true
    default-column-width { fixed 760; }
    default-window-height { fixed 600; }
}

window-rule {
    match title="Helix Linux Installer"
    match app-id="Calamares"
    match app-id="calamares"
    open-floating true
    default-column-width { fixed 800; }
    default-window-height { fixed 520; }
}

// Noctalia v4 se carga como config de Quickshell (sin binario propio).
// También se abre el welcome y el agente polkit para Calamares/pkexec.
spawn-at-startup "qs" "-c" "noctalia-shell"
spawn-at-startup "/usr/bin/archlatam-welcome"
spawn-at-startup "/usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1"

binds {
    Mod+Shift+Slash { show-hotkey-overlay; }

    Mod+Return { spawn "kitty"; }
    Mod+D { spawn "qs" "-c" "noctalia-shell" "ipc" "call" "launcher" "toggle"; }

    Mod+Q { close-window; }
    Mod+Shift+E { quit; }

    Mod+Left  { focus-column-left; }
    Mod+Right { focus-column-right; }
    Mod+Down  { focus-window-down; }
    Mod+Up    { focus-window-up; }
    Mod+Shift+Left  { move-column-left; }
    Mod+Shift+Right { move-column-right; }

    Mod+F { maximize-column; }
    Mod+Shift+F { fullscreen-window; }
    Mod+R { switch-preset-column-width; }
    Mod+V { toggle-window-floating; }

    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+Shift+1 { move-column-to-workspace 1; }
    Mod+Shift+2 { move-column-to-workspace 2; }
    Mod+Shift+3 { move-column-to-workspace 3; }
    Mod+Shift+4 { move-column-to-workspace 4; }
    Mod+Shift+5 { move-column-to-workspace 5; }

    Print { screenshot; }
    Ctrl+Print { screenshot-screen; }
    Alt+Print { screenshot-window; }

    XF86AudioRaiseVolume allow-when-locked=true { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "0.05+"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "0.05-"; }
    XF86AudioMute        allow-when-locked=true { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SINK@" "toggle"; }
    XF86MonBrightnessUp   allow-when-locked=true { spawn "brightnessctl" "set" "5%+"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "brightnessctl" "set" "5%-"; }
}
